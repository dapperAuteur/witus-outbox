# witus-outbox environment template.
# Copy to .env.local for local dev. Do NOT commit real secrets.
# Vercel env-vars set per environment (Production / Preview / local) per
# plans/00-descriptions.md §3 "Environments & Neon branches".

# --- Database (Neon) ---
# Auto-injected by Vercel-Neon integration in deployed envs. Locally, copy
# the dev branch URL from your Vercel dashboard.
STORAGE_DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# --- Single-admin gate + NextAuth ---
# Email of the only account allowed to sign in to the triage UI. Read by
# proxy.ts and lib/auth.ts to fail closed on any other email.
ADMIN_EMAIL="bam@awews.com"
# NextAuth canonical URL. Production only (e.g. https://outbox.witus.online).
# Leave unset locally and on Preview — NextAuth v4 falls back to VERCEL_URL
# / the request origin.
# NEXTAUTH_URL=""
# Generate via: openssl rand -base64 32. Distinct per env.
NEXTAUTH_SECRET="<base64-32+ chars>"
# NextAuth EmailProvider SMTP. Same Mailgun account as inbox; outbox sends
# magic links from the EMAIL_FROM address below.
# Format: smtp://postmaster@<mailgun-domain>:<smtp-pwd>@smtp.mailgun.org:587
EMAIL_SERVER="smtp://postmaster@mg.witus.online:<smtp-pwd>@smtp.mailgun.org:587"

# --- Mailgun (outbox-fired failure alerts; later: NextAuth magic links) ---
# Optional in local/preview — lib/mailgun.ts dev-logs when missing. Required
# in Production: refusing-to-send is the prod-guard branch (charter §3).
# EMAIL_FROM's domain must be a verified sending domain on the Mailgun
# account (e.g. mg.witus.online, NOT the parent witus.online unless that
# domain is also added in Mailgun and DKIM/SPF are configured).
EMAIL_FROM="WitUS Outbox <outbox@mg.witus.online>"
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mg.witus.online"
# Recipient for outbox-fired failure alert emails. Falls back to ADMIN_EMAIL
# when unset.
ALERT_EMAIL=""

# --- HMAC ingest registry ---
# JSON array of {slug, hmac_secret} per source. Min 32 chars per secret.
# Generate via: openssl rand -hex 32
INGEST_SOURCES='[{"slug":"radaar-csv-import","hmac_secret":"<32-byte-hex>"}]'

# --- Mobile Text Alerts (SMS on publisher failures) ---
# Optional in local/preview — lib/sms.ts dev-logs when missing.
# RECIPIENTS is a JSON array of E.164 phone numbers, e.g. ["+13175551234"].
MOBILE_TEXT_ALERTS_API_KEY=""
MOBILE_TEXT_ALERTS_RECIPIENTS=""

# --- Publisher backend ---
# Which lib/publishers/<backend>.ts adapter is active. v1 ships "ocoya".
# Future adapters (radaar, socialchamp) land as separate slices; flipping
# this env var is the entire swap operation.
PUBLISHER_BACKEND="ocoya"

# --- Ocoya (active publisher backend at v1) ---
# Optional in local/preview — lib/publishers/ocoya.ts dev-logs when missing.
# Required in Production: see plans/user-tasks/03-ocoya-api-key-and-profiles.md.
# Generate at https://app.ocoya.com/general/settings/api (not retrievable after
# initial creation; lost keys require replacement).
OCOYA_API_KEY=""
OCOYA_WORKSPACE_ID=""

# --- Future adapter env vars (placeholders; not read by code yet) ---
# These land when their adapter slices ship. See
# plans/future/multi-backend-rollout.md for the rollout order.
# RADAAR_API_KEY=""
# SOCIAL_CHAMP_API_KEY=""
